# ---------------------------------------------------------------
# QuantumShift configuration — copy to .env and adjust.
# NEVER commit real keys. Secrets are read only by the server;
# nothing here is ever sent to the browser.
# ---------------------------------------------------------------

# API server
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session signing secret (>= 32 chars). If empty, an ephemeral per-process
# secret is generated and sessions reset on restart.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=8h

# PostgreSQL. Leave empty to use the embedded PostgreSQL engine (PGlite),
# persisted under server/data/pglite.
# DATABASE_URL=postgres://quantumshift:change-me@localhost:5432/quantumshift
DATABASE_URL=
PGLITE_DATA_DIR=data/pglite

# demo | real  (can also be toggled in the UI by a CTO/CISO)
DEFAULT_MODE=demo

# Visual pacing between pipeline stages in ms (0 = as fast as possible)
PACING_MS=450
RATE_LIMIT_PER_MINUTE=600
UPLOAD_MAX_MB=20
UPLOAD_DIR=data/uploads

# Optional — IBM Granite on watsonx.ai (used only in REAL mode)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
